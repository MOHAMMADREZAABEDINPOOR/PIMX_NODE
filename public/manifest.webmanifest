{
  "id": "/",
  "name": "PIMXNODE — Files in motion",
  "short_name": "PIMXNODE",
  "description": "Send files and notes between your devices.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#faf5fc",
  "theme_color": "#61275b",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  }
}

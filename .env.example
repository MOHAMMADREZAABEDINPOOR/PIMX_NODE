# Node signaling server port. Use HTTPS at the reverse proxy in production.
PORT=3000
# Optional TURN relay for networks that block direct peer connections.
# Values are returned only to clients using this instance; use scoped/rotating
# deployment credentials and rate limits on your TURN service in production.
TURN_URL=
# Preferred: coturn use-auth-secret / static-auth-secret. Issues one-hour credentials.
TURN_SHARED_SECRET=
# Optional alternative for providers using fixed scoped credentials.
TURN_USERNAME=
TURN_CREDENTIAL=

# Public HTTPS origin used for canonical URLs, social cards and sitemap at build time.
VITE_SITE_URL=
